#!/bin/sh
# MODULE: git pre-push hook — blocks a push to main/master when the committed MAP files don't match the code.
# Install: cp tools/map/hooks/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push
# (With husky or core.hooksPath, add the loop below to the pre-push hook that's already there.)
root=$(git rev-parse --show-toplevel) || exit 0
map="$root/tools/map/map.mjs"
[ -f "$map" ] && command -v node >/dev/null 2>&1 || exit 0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main|refs/heads/master) ;;
    *) continue ;;
  esac
  # check reads the working tree, so a regenerated-but-uncommitted map would pass while the pushed one is stale
  if [ -n "$(git -C "$root" status --porcelain -- ':(glob)**/MAP*.md' ':(glob)**/MAP.html')" ]; then
    echo "pre-push: MAP files have uncommitted changes — commit them, then push again." >&2
    exit 1
  fi
  node "$map" check --root "$root" || exit 1
done
exit 0
